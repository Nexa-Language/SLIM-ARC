ARG BASE_IMAGE=slim-arc-llama:360e134
FROM ${BASE_IMAGE} AS build-runtime

ARG SLIM_ARC_BASE_GIT_COMMIT
ARG SLIM_ARC_GIT_COMMIT
ARG SLIM_ARC_BUILD_CONTEXT_SHA256

RUN test "$(sed -n 's/^SLIM_ARC_GIT_COMMIT=//p' /opt/build-manifest.env)" = "${SLIM_ARC_BASE_GIT_COMMIT}" \
    && printf '%s\n' "${SLIM_ARC_GIT_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s\n' "${SLIM_ARC_BUILD_CONTEXT_SHA256}" | grep -Eq '^[0-9a-f]{64}$'

COPY scripts/apply-slim-arc.py /opt/slim-arc/scripts/apply-slim-arc.py
COPY patches/llama-upstream/ /opt/slim-arc/patches/llama-upstream/

RUN for file in llama-model-loader.cpp llama-model.cpp llama-context.cpp llama-kv-cache.cpp CMakeLists.txt; do \
        cp "/opt/llama-upstream/src/${file}" "/opt/llama-patched/src/${file}"; \
    done \
    && python3 /opt/slim-arc/scripts/apply-slim-arc.py /opt/llama-patched > /opt/patch-apply-first.log \
    && before_hash="$(find /opt/llama-patched/src -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')" \
    && python3 /opt/slim-arc/scripts/apply-slim-arc.py /opt/llama-patched > /opt/patch-apply-second.log \
    && after_hash="$(find /opt/llama-patched/src -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')" \
    && test "${before_hash}" = "${after_hash}" \
    && printf 'PATCH_IDEMPOTENT=1\nPATCHED_SOURCE_SHA256=%s\n' "${before_hash}" > /opt/patch-idempotent.env

RUN cmake --build /opt/llama-patched/build --parallel 8 --target llama-cli llama-bench

RUN { \
        grep -E '^(LLAMA_COMMIT|LLAMA_RESOLVED_COMMIT|GGML_CPU_REPACK|GGML_METAL|BASELINE_PATCHED|SLIM_ARC_PATCHED|COMPILER|CMAKE)=' /opt/build-manifest.env; \
        printf 'SLIM_ARC_GIT_COMMIT=%s\n' "${SLIM_ARC_GIT_COMMIT}"; \
        printf 'SLIM_ARC_BUILD_CONTEXT_SHA256=%s\n' "${SLIM_ARC_BUILD_CONTEXT_SHA256}"; \
        cat /opt/patch-idempotent.env; \
    } > /opt/build-manifest.next \
    && mv /opt/build-manifest.next /opt/build-manifest.env

COPY scripts/macos/container/run-benchmark.sh /usr/local/bin/slim-arc-run-benchmark
COPY scripts/macos/container/run_manifest.py /opt/slim-arc-runner/run_manifest.py
RUN chmod 0755 /usr/local/bin/slim-arc-run-benchmark /opt/slim-arc-runner/run_manifest.py

FROM build-runtime AS test
COPY scripts/macos/container/fake-llama-bench.sh /opt/slim-arc-test/fake-llama-bench
RUN chmod 0755 /opt/slim-arc-test/fake-llama-bench \
    && touch /opt/slim-arc-test-enabled

FROM build-runtime AS runtime
