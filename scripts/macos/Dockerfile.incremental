ARG BASE_IMAGE=slim-arc-llama-test:360e134
FROM ${BASE_IMAGE}

ARG SLIM_ARC_GIT_COMMIT
ARG SLIM_ARC_BUILD_CONTEXT_SHA256

RUN printf '%s\n' "${SLIM_ARC_GIT_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s\n' "${SLIM_ARC_BUILD_CONTEXT_SHA256}" | grep -Eq '^[0-9a-f]{64}$'

COPY scripts/apply-slim-arc.py /opt/slim-arc-incremental/scripts/apply-slim-arc.py
COPY patches/llama-upstream/ /opt/slim-arc-incremental/patches/llama-upstream/

RUN python3 /opt/slim-arc-incremental/scripts/apply-slim-arc.py /opt/llama-patched > /opt/patch-apply-first.log \
    && before_hash="$(find /opt/llama-patched/src -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')" \
    && python3 /opt/slim-arc-incremental/scripts/apply-slim-arc.py /opt/llama-patched > /opt/patch-apply-second.log \
    && after_hash="$(find /opt/llama-patched/src -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')" \
    && test "${before_hash}" = "${after_hash}" \
    && cmake --build /opt/llama-patched/build --parallel 8 --target llama-cli llama-bench \
    && sed -i '/^SLIM_ARC_GIT_COMMIT=/d; /^SLIM_ARC_BUILD_CONTEXT_SHA256=/d; /^PATCH_IDEMPOTENT=/d; /^PATCHED_SOURCE_SHA256=/d' /opt/build-manifest.env \
    && printf 'SLIM_ARC_GIT_COMMIT=%s\nSLIM_ARC_BUILD_CONTEXT_SHA256=%s\nPATCH_IDEMPOTENT=1\nPATCHED_SOURCE_SHA256=%s\n' \
        "${SLIM_ARC_GIT_COMMIT}" "${SLIM_ARC_BUILD_CONTEXT_SHA256}" "${before_hash}" >> /opt/build-manifest.env \
    && rm -rf /opt/slim-arc-incremental

COPY scripts/macos/container/run-benchmark.sh /usr/local/bin/slim-arc-run-benchmark
COPY scripts/macos/container/run_manifest.py /opt/slim-arc-runner/run_manifest.py
COPY scripts/macos/container/fake-llama-bench.sh /opt/slim-arc-test/fake-llama-bench

RUN chmod 0755 /usr/local/bin/slim-arc-run-benchmark \
    /opt/slim-arc-runner/run_manifest.py \
    /opt/slim-arc-test/fake-llama-bench

LABEL org.slim-arc.build-mode="incremental-performance-iteration"
